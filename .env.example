# PostgreSQL
POSTGRES_USER=marketuser
POSTGRES_PASSWORD=marketpass
POSTGRES_DB=marketreplay

# 公共行情源：Binance / Hyperliquid / Dukascopy / Yahoo Finance（无需 API Key）

# App
DEBUG=false

# 单用户访问密码（登录页使用；为空则登录接口返回 503，务必改成强密码）
APP_PASSWORD=

# 系统机会通知（不配置 Webhook 时仍会保存为站内通知）
OPPORTUNITY_ALERTS_ENABLED=true
DISCORD_WEBHOOK_URL=
ALERT_TIMEZONE=Asia/Taipei

# 每日市场日报（ALERT_TIMEZONE 时区）
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0

# SMTP 完整版日报；REPORT_EMAIL_TO 可用逗号分隔多个收件人
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# 缠论买卖点/背驰/抢先告警（依赖仓库根 fenxing/ 目录，缺失时自动降级跳过）
CHANLUN_ALERTS_ENABLED=true
CHANLUN_SCAN_INTERVAL_MIN=60
# 实时告警覆盖标的（BTC 扫 1D/4H/1H 三周期，其余扫 1D）
CHANLUN_SYMBOLS=BTC-USD,000001.SS,399006.SZ,000688.SS,^IXIC,^GSPC,GC=F,SI=F,CL=F
CHANLUN_MIN_BARS=120
# 首次启动时仅投递最近 72 小时内的信号，避免历史回填刷屏
CHANLUN_LOOKBACK_HOURS=72
# 日报「日线机会」收录最近 N 天内确认的缠论买卖点
CHANLUN_REPORT_LOOKBACK_DAYS=7

# M3B 影子运行时（V2 影子决策/标注；默认关闭，全验收后才在本机 .env 开启）
# 独立 worker 读取已持久化的 4H AlertEvent，不改 monitor_engine；
# 关闭时调度 job 零 DB/零网络；开启后以 DB heartbeat 首次启用时刻为准，
# 不回填旧事件冒充 live shadow。
M3_SHADOW_ENABLED=false
# 首批 allowlist：仅 BINANCE:BTCUSDT（只证明 crypto UTC，混入股票/TradFi 会污染样本）
M3_SHADOW_SYMBOLS=
M3_SHADOW_TIMEFRAME=4h
# 每次取各周期最多 K 线根数（猜测值，足够 M1 warmup；实测不足时记录并调此常量，
# 不改 M1/M2/M3A 口径）
M3_SHADOW_MAX_BARS=700
# 影子 job 调度间隔（分钟）
M3_SHADOW_INTERVAL_MIN=1
# decision 失败退避（秒）
M3_SHADOW_RETRY_DELAY_SECONDS=300
# 缺数据/部分成熟 backoff（秒；正常缺根不算 failed，但不得每分钟热循环）
M3_SHADOW_LABEL_RETRY_DELAY_SECONDS=900
M3_SHADOW_MAX_ATTEMPTS=6
M3_SHADOW_INGEST_LIMIT=200
M3_SHADOW_LABEL_LIMIT=200
